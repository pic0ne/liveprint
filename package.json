{
  "name": "liveprint",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "tsx --import ./bench/raw.mjs bench/compile.ts",
    "record:demo": "vite build --logLevel error && node bench/record-demo.mjs",
    "bench:browser": "vite build --logLevel error && node bench/browser.mjs",
    "check:linking": "vite build --logLevel error && node bench/check-linking.mjs --theme book && node bench/check-linking.mjs --theme paper && node bench/check-linking.mjs --theme modern",
    "bench:load": "vite build --logLevel error && node bench/load.mjs",
    "check:files": "vite build --logLevel error && node bench/check-files.mjs",
    "check:images": "vite build --logLevel error && node bench/check-images.mjs",
    "check:themes": "vite build --logLevel error && node bench/check-themes.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0"
  }
}
